# Copy to .env and fill in secrets:  cp .env.example .env
# `make up` generates a .env with random passwords if none exists.

# --- PrestaShop image -------------------------------------------------------
# 9.1.4 is the current stable 9.x. Tag format: <ps-version>-<php-version>
# PS 9 supports PHP 8.2-8.5; 8.3 is the safest bet for third-party modules.
PS_VERSION=9.1.4-8.3

# --- Ports ------------------------------------------------------------------
PS_PORT=9080
PMA_PORT=9081
MAILPIT_UI_PORT=9025

# --- Shop -------------------------------------------------------------------
# PS_DOMAIN must include the port, or generated URLs will drop it.
PS_DOMAIN=localhost:9080
# Installer language/country. Extra languages (fr-CA, en-US) and currencies
# are added afterwards by `make provision`.
PS_LANGUAGE=en
PS_COUNTRY=ca
PS_FOLDER_ADMIN=admin-cryptocards

# --- Admin account ----------------------------------------------------------
ADMIN_MAIL=admin@cryptocards.test
ADMIN_PASSWORD=CHANGE_ME_admin_password

# --- Database ---------------------------------------------------------------
DB_NAME=cryptocards
DB_USER=cryptocards
DB_PASSWORD=CHANGE_ME_db_password
DB_ROOT_PASSWORD=CHANGE_ME_root_password
DB_PREFIX=cc_

# --- Search -----------------------------------------------------------------
MEILI_PORT=9700
MEILI_MASTER_KEY=CHANGE_ME_meili_key

# Timezone for scheduled jobs (cron). e.g. America/Toronto
TZ=UTC
