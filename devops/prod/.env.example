# Production environment. Copy to .env on the host and fill in real values.
#
# Production is a Swarm stack, so this file is read by whoever runs the deploy
# rather than by a running container:
#
#   set -a; . ./devops/prod/.env; set +a
#   docker stack deploy -c devops/prod/stack.yml doublesleeve
#
# The image is the artifact: deploying a version means changing APP_IMAGE_TAG
# and running that again. Rolling back means naming the previous tag.
APP_IMAGE=ghcr.io/karlokr/doublesleeve
APP_IMAGE_TAG=v0.0.3

# Traefik terminates TLS and routes on this host, so no port is published.
PS_DOMAIN=doublesleeve.org
PS_FOLDER_ADMIN=admin-doublesleeve

DB_NAME=doublesleeve
DB_USER=doublesleeve
DB_PASSWORD=
DB_ROOT_PASSWORD=

MEILI_MASTER_KEY=

# Source CIDRs allowed to reach Portainer. Comma separated, /32 for a single
# host. Get yours with `curl -s ifconfig.me`; the value below is the address the
# server's own SSH banner last recorded, which is a starting point, not a
# verified answer.
ADMIN_ALLOWLIST=174.7.36.28/32
