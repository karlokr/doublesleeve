# Production environment. Copy to .env on the host and fill in real values.
#
# Production is split across stacks, each with its own lifecycle. In Portainer
# these values go in the stack's own Environment variables panel; from a shell:
#
#   set -a; . /swarm/stacks/.env; set +a
#   docker stack deploy -c /swarm/stacks/app.yml doublesleeve
#
# Which stack needs what:
#
#   db.yml      DB_NAME DB_USER DB_PASSWORD DB_ROOT_PASSWORD
#   search.yml  MEILI_MASTER_KEY
#   app.yml     APP_IMAGE_TAG DB_NAME DB_USER DB_PASSWORD PS_DOMAIN
#               PS_FOLDER_ADMIN MEILI_MASTER_KEY
#   traefik.yml CF_DNS_API_TOKEN
#
# MEILI_MASTER_KEY appears twice too, in search and app: the shop's search
# controller calls Meilisearch directly and authenticates with it.
#
# The database credentials appear twice, in db and app. That is the cost of the
# split, and it is cheaper than the alternative: they are one fact in this file,
# and only fan out at deploy time.
#
# The image is the artifact: deploying a version means changing APP_IMAGE_TAG
# and redeploying app.yml. Rolling back means naming the previous tag.
APP_IMAGE=ghcr.io/karlokr/doublesleeve
APP_IMAGE_TAG=v0.0.3

# Traefik terminates TLS and routes on this host, so no port is published.
PS_DOMAIN=doublesleeve.org
PS_FOLDER_ADMIN=admin-doublesleeve

DB_NAME=doublesleeve
DB_USER=doublesleeve
DB_PASSWORD=
DB_ROOT_PASSWORD=

MEILI_MASTER_KEY=

# Cloudflare API token for the DNS-01 challenge (traefik.yml).
CF_DNS_API_TOKEN=
